---
import '../index.css';

const {
  title = 'Kevin Gallardo - Full Stack Developer',
  description = 'Full Stack Developer apasionado por construir soluciones digitales eficientes, escalables y con diseño impecable. Especializado en Frontend, IoT y AI.',
  keywords = 'Kevin Gallardo, Full Stack Developer, Frontend, React, TypeScript, IoT, Machine Learning, Portfolio',
  canonicalPath = '/',
  imagePath = '/photo.avif',
  type = 'website',
} = Astro.props;

const site = Astro.site ?? new URL('https://keevh.dev');
const canonicalUrl = new URL(canonicalPath, site).toString();
const imageUrl = new URL(imagePath, site).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Kevin Gallardo" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type"        content={type} />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={imageUrl} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name"   content="Kevin Gallardo" />
    <meta property="og:locale"      content="es_AR" />

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={imageUrl} />
    <meta name="twitter:creator"     content="@kevingallardo" />

    <meta name="theme-color" content="#050505" />
    <meta name="color-scheme" content="dark" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Geist:wght@400;600&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />

    <script is:inline>
      const storedLanguage = window.localStorage.getItem('portfolio-language');
      if (storedLanguage === 'es' || storedLanguage === 'en') {
        document.documentElement.lang = storedLanguage;
      }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Kevin Gallardo",
      "url": "https://keevh.dev",
      "email": "andreskevin2606@gmail.com",
      "jobTitle": "Full Stack Developer",
      "description": "Full Stack Developer apasionado por construir soluciones digitales eficientes, escalables y con diseño impecable. Especializado en Frontend, IoT y AI.",
      "sameAs": [
        "https://github.com/keevh",
        "https://www.linkedin.com/in/keevh/"
      ],
      "knowsAbout": ["React", "TypeScript", "Node.js", "IoT", "MQTT", "Machine Learning", "Full Stack Development"]
    }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
